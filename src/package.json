{
  "name": "privacy.md",
  "version": "0.1.0",
  "description": "A privacy boundary for personal AI agents, enforced before the data leaves your machine. AGENTS.md tells an agent how to work; privacy.md tells it what it may send.",
  "keywords": [
    "privacy",
    "ai-agents",
    "agent",
    "llm",
    "data-minimization",
    "agent-security",
    "claude-code",
    "openai-agents",
    "gdpr",
    "mcp"
  ],
  "homepage": "https://github.com/snoels/privacy.md#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snoels/privacy.md.git"
  },
  "bugs": {
    "url": "https://github.com/snoels/privacy.md/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "privacy.md": "./bin/cli.js"
  },
  "exports": {
    ".": "./kernel/index.js"
  },
  "files": [
    "bin/",
    "kernel/",
    "adapters/",
    "constitutions/",
    "demo/",
    "examples/"
  ],
  "scripts": {
    "test": "node --import ./test/setup.js --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@openai/agents": "^0.17.0",
    "zod": "^4.5.4"
  }
}
